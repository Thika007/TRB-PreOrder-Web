# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment configurations (Keep secrets and DB passwords private)
.env
backend/.env
*.env.local

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*

# Database backups and temp files
*.bak
*.mdf
*.ldf

# Build and report artifacts
output/
playwright-report/
test-results/
frontend/dist/
build/
scratch/

# Allow Client Delivery Package
!Client_Delivery/dist/
!Client_Delivery/dist/**
!Client_Delivery/backend/.env

# Operating system files
.DS_Store
Thumbs.db

# Office temporary files
~$*.docx
~$*.xlsx
